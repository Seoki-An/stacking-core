<?xml version="1.0"?>
<robot name="test_robot">
  <link name="world"/>

  <link name="base">
    <inertial>
      <origin xyz="0.1 0.2 0.3" rpy="0 0 0.5"/>
      <mass value="2.0"/>
      <inertia ixx="2" ixy="0" ixz="0" iyy="3" iyz="0" izz="4"/>
    </inertial>
    <visual>
      <geometry><box size="1 1 1"/></geometry>
    </visual>
    <collision>
      <origin xyz="1 2 3"/>
      <geometry><dsf_vert filename="robot.obj"/></geometry>
    </collision>
  </link>
  <joint name="floating_base" type="floating">
    <parent link="world"/>
    <child link="base"/>
  </joint>

  <link name="arm"/>
  <joint name="shoulder" type="revolute">
    <parent link="base"/>
    <child link="arm"/>
    <origin xyz="1 0 0"/>
    <axis xyz="0 0 2"/>
    <limit lower="-1" upper="1" effort="10" velocity="2"/>
  </joint>

  <link name="finger"/>
  <joint name="finger_mimic" type="revolute">
    <parent link="arm"/>
    <child link="finger"/>
    <origin xyz="1 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1" upper="1" effort="10" velocity="2"/>
    <mimic joint="shoulder" multiplier="-1" offset="0.1"/>
  </joint>

  <link name="tip"/>
  <joint name="finger_to_tip" type="fixed">
    <parent link="finger"/>
    <child link="tip"/>
    <origin xyz="1 0 0"/>
  </joint>

  <link name="wheel"/>
  <joint name="wheel_joint" type="continuous">
    <parent link="base"/>
    <child link="wheel"/>
    <axis xyz="0 1 0"/>
  </joint>
</robot>
