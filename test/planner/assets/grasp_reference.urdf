<?xml version="1.0"?>
<robot name="grasp_reference">
  <link name="world"/>
  <link name="root"/>
  <joint name="floating_root" type="floating">
    <parent link="world"/>
    <child link="root"/>
  </joint>

  <link name="left_pad">
    <collision>
      <geometry>
        <dsf_vert filename="test/planner/assets/grasp_pad.obj" contact="true"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_opening" type="prismatic">
    <parent link="root"/>
    <child link="left_pad"/>
    <origin xyz="1.1 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-0.1" upper="0.1"/>
  </joint>

  <link name="right_pad">
    <collision>
      <geometry>
        <dsf_vert filename="test/planner/assets/grasp_pad.obj" contact="true"/>
      </geometry>
    </collision>
  </link>
  <joint name="right_opening" type="prismatic">
    <parent link="root"/>
    <child link="right_pad"/>
    <origin xyz="-1.1 0 0"/>
    <axis xyz="-1 0 0"/>
    <limit lower="-0.1" upper="0.1"/>
  </joint>
</robot>
